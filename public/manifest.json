{
  "manifest_version": 3,
  "name": "Zoom for Kids",
  "version": "1.1.0",
  "description": "Big, colorful buttons for Zoom meetings — made for kids. Reactions, hand raise, and mute in 5 languages.",
  "permissions": [],
  "host_permissions": ["https://*.zoom.us/wc/*"],
  "content_scripts": [
    {
      "matches": ["https://*.zoom.us/wc/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
