{
  "name": "zoom-for-kids",
  "version": "1.0.0",
  "description": "A kid-friendly control panel extension for Zoom web meetings",
  "scripts": {
    "dev": "vite build --watch",
    "dev:zoom-app": "vite --config vite.zoom-app.config.ts",
    "build": "vite build",
    "build:extension": "vite build",
    "build:zoom-app": "vite build --config vite.zoom-app.config.ts",
    "build:all": "npm run build:extension && npm run build:zoom-app",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-web-extension": "^4.1.1"
  },
  "dependencies": {
    "@zoom/appssdk": "^0.16.37",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
